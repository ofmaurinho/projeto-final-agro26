rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validMateria(data) {
      return data.keys().hasAll(['nome', 'uid', 'createdAt'])
        && data.keys().hasOnly(['nome', 'cor', 'uid', 'createdAt'])
        && data.nome is string
        && data.nome.size() > 0
        && data.uid == request.auth.uid
        && data.createdAt is timestamp
        && (!('cor' in data) || data.cor is string);
    }

    function validSession(data) {
      return data.keys().hasAll([
          'titulo', 'materiaId', 'data', 'duracaoMinutos', 'uid',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'titulo', 'materiaId', 'data', 'duracaoMinutos', 'descricao',
          'uid', 'createdAt', 'updatedAt'
        ])
        && data.titulo is string
        && data.titulo.size() > 0
        && data.materiaId is string
        && data.data is timestamp
        && data.duracaoMinutos is int
        && data.duracaoMinutos > 0
        && data.uid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('descricao' in data) || data.descricao is string)
        && exists(/databases/$(database)/documents/materias/$(data.materiaId))
        && get(/databases/$(database)/documents/materias/$(data.materiaId)).data.uid
          == request.auth.uid;
    }

    match /materias/{materiaId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validMateria(request.resource.data);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && validMateria(request.resource.data);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /sessoes_estudo/{sessaoId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validSession(request.resource.data);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && validSession(request.resource.data);
    }

    match /perfis/{uid} {
      allow read: if signedIn()
        && uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/perfis/$(uid))
          || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nomeExibicao', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'nomeExibicao', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nomeExibicao is string
        && request.resource.data.nomeExibicao.size() > 0
        && request.resource.data.updatedAt is timestamp;
      allow update: if signedIn()
        && uid == request.auth.uid
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nomeExibicao', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'nomeExibicao', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.nomeExibicao is string
        && request.resource.data.nomeExibicao.size() > 0
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
  }
}
